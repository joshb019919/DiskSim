source ./hp_c3323a.diskspecs

instantiate [ 
   statfoo
] as Stats

instantiate [ 
   bus0
] as BUS0

instantiate [ 
   bus1
] as BUS1

instantiate [ 
   driver0
] as DRIVER0

instantiate [ 
   disk, 
   cache_disk
] as HP_C3323A

instantiate [ 
   ctlr0
] as CTLR0

topospec disksim_iodriver driver0 [ 
   disksim_bus bus0 [ 
      disksim_ctlr ctlr0 [ 
         disksim_bus bus1 [ 
            disksim_disk disk [ ], 
            disksim_disk cache_disk [ ]
         ]
      ]
   ]
]

