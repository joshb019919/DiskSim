source ./hp_c3323a.diskspecs

instantiate [ 
   statfoo
] as Stats

instantiate [ 
   bus0
] as BUS0

instantiate [ 
   bus1
] as BUS1

instantiate [ 
   disk0
] as HP_C3323A

instantiate [ 
   driver0
] as DRIVER0

instantiate [ 
   ctlr0
] as CTLR0

topospec disksim_iodriver driver0 [ 
   disksim_bus bus0 [ 
      disksim_ctlr ctlr0 [ 
         disksim_bus bus1 [ 
            disksim_disk disk0 [ ]
         ]
      ]
   ]
]

